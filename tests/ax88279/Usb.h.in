// SPDX-License-Identifier: GPL-2.0-or-later
// Host-only USB transport mock. The test runner copies the production driver
// next to this header so the normal library and Arduino builds are unaffected.
#pragma once
#include <algorithm>
#include <cstdint>
#include <cstring>
#include <deque>
#include <vector>
#include <map>
#include <tuple>
#define _usb_h_
#include "usb_ch9.h"
#define USB_ERROR_CLASS_INSTANCE_ALREADY_IN_USE 0xD9
#define USB_DEV_CONFIG_ERROR_DEVICE_NOT_SUPPORTED 0xD1
#define USB_ERROR_EPINFO_IS_NULL 0xD7
#define USB_ERROR_INVALID_MAX_PKT_SIZE 0xDA
#define USB_ERROR_OUT_OF_ADDRESS_SPACE_IN_POOL 0xD4
#define USB_ERROR_ADDRESS_NOT_FOUND_IN_POOL 0xD6
#define USB_ERROR_INVALID_ARGUMENT 0xD8
#define USB_NAK_MAX_POWER 15
#define USB_NAK_NOWAIT 1
#define hrNAK 4
inline void delay(unsigned) {}
class USBReadParser {
public:
    virtual void Parse(const uint16_t, const uint8_t *, const uint16_t &) = 0;
};
class USBDeviceConfig {};
struct EpInfo { uint8_t epAddr, maxPktSize, bmNakPower; };
struct UsbDevice { EpInfo *epinfo; bool lowspeed; };
class AddressPool {
    EpInfo ep0 = {0, 8, 15};
    UsbDevice devices[2] = {{&ep0, false}, {nullptr, false}};
public:
    bool allocated = false;
    UsbDevice *GetUsbDevicePtr(uint8_t address) { return address < 2 ? devices + address : nullptr; }
    uint8_t AllocAddress(uint8_t, bool, uint8_t) { allocated = true; return 1; }
    void FreeAddress(uint8_t) { allocated = false; }
};
struct Transfer { uint8_t rc; std::vector<uint8_t> data; };
class USB {
public:
    AddressPool pool;
    USB_DEVICE_DESCRIPTOR descriptor = {18, 1, 0x200, 0, 0, 0, 64, 0x0b95, 0x1790, 0x400, 0, 0, 0, 1};
    std::vector<uint8_t> config = {9, 2, 53, 0, 1, 1, 0, 0x80, 225,
        9, 4, 0, 0, 5, 0xff, 0xff, 0, 0,
        7, 5, 0x81, 3, 8, 0, 160, 7, 5, 0x82, 2, 64, 0, 0,
        7, 5, 3, 2, 64, 0, 0, 7, 5, 0x84, 2, 64, 0, 0,
        7, 5, 5, 2, 64, 0, 0};
    uint8_t chip = 0x74;
    int shortRequest = -1, failRequest = -1, writes = 0;
    uint8_t epCount = 0;
    uint16_t lastOutLength = 0;
    std::vector<uint8_t> lastOut;
    std::deque<Transfer> incoming;
    std::map<std::tuple<int, int, int>, std::vector<uint8_t>> registers;
    AddressPool &GetAddressPool() { return pool; }
    void RegisterDeviceClass(USBDeviceConfig *) {}
    uint8_t getDevDescr(uint8_t, uint8_t, uint16_t n, uint8_t *p) {
        std::memcpy(p, &descriptor, n); return 0;
    }
    uint8_t setAddr(uint8_t, uint8_t, uint8_t) { return 0; }
    uint8_t setEpInfoEntry(uint8_t address, uint8_t count, EpInfo *p) {
        epCount = count; pool.GetUsbDevicePtr(address)->epinfo = p; return 0;
    }
    uint8_t setConf(uint8_t, uint8_t, uint8_t) { return 0; }
    uint8_t ctrlReq(uint8_t, uint8_t, uint8_t direction, uint8_t request, uint8_t lo,
                    uint8_t hi, uint16_t index, uint16_t total, uint16_t chunk,
                    uint8_t *p, USBReadParser *parser) {
        if(request == failRequest) return 0x0d;
        int value = lo | (int(hi) << 8);
        auto key = std::make_tuple(request, value, index);
        if(direction == 0x40) {
            ++writes;
            registers[key] = total ? std::vector<uint8_t>(p, p + total) : std::vector<uint8_t>();
            return 0;
        }
        std::vector<uint8_t> data(total, 0);
        if(direction == 0x80) data.assign(config.begin(), config.begin() + std::min<size_t>(total, config.size()));
        else if(request == 1 && value == 5) data[0] = chip;
        else if(request == 1 && value == 0x10) { for(int i = 0; i < 6; ++i) data[i] = i + 1; }
        else if(request == 2) {
            unsigned word = index == 1 ? 4 : index == 9 ? 0x200 : index == 10 ? 0x800 : 0;
            data[0] = word; data[1] = word >> 8;
        } else if(registers.count(key) && registers[key].size() == total) data = registers[key];
        else if(request == 0x13) { data[0] = 123; data[4] = 1; }
        if(request == shortRequest && data.size()) data.resize(data.size() - 1);
        for(uint16_t offset = 0; offset < data.size();) {
            uint16_t n = std::min<size_t>(chunk, data.size() - offset);
            std::memcpy(p, data.data() + offset, n);
            if(parser) parser->Parse(n, p, offset);
            offset += n;
        }
        return 0;
    }
    uint8_t inTransfer(uint8_t address, uint8_t ep, uint16_t *n, uint8_t *p) {
        if(ep == 1) {
            if(*n != pool.GetUsbDevicePtr(address)->epinfo[1].maxPktSize) return 0x0d;
            std::memset(p, 0, *n); p[1] = 3; p[2] = 1; return 0;
        }
        if(incoming.empty()) return hrNAK;
        auto t = incoming.front(); incoming.pop_front();
        if(t.rc) return t.rc;
        *n = std::min<size_t>(*n, t.data.size()); std::memcpy(p, t.data.data(), *n); return 0;
    }
    uint8_t outTransfer(uint8_t, uint8_t, uint16_t n, uint8_t *p) {
        lastOutLength = n; lastOut.assign(p, p + n); return 0;
    }
};
